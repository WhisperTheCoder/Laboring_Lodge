<script> function startbutton() {
var StartButton = document.getElementById("startbutton"); 
var StartText = document.getElementById("starttext");
var PeltsGathered = document.getElementById("PeltsGathered");
var PeltButton = document.getElementById('PeltButton');
WoodGathered.textContent = `Wood:${Wood}`;
PeltsGathered.textContent = `Pelts:${Pelts}`;
StartButton.style.display = "none"; 
StartText.style.display= "none"; 
WoodGatherButton.classList.remove('hiddenButtonReveal');
WoodGathered.classList.remove('hiddenButtonReveal');
PeltsGathered.classList.remove('hiddenButtonReveal');
PeltButton.classList.remove('hiddenButtonReveal');
}
</script>
<script>
var Wood = 0; 

function GatherWood() {

let timeLeft = 5;
  const WoodGatherButton = document.getElementById('WoodGatherButton');
  const WoodGathered = document.getElementById('WoodGathered');
  WoodGatherButton.disabled = true;
  
  timeLeft = 5; 
  WoodGatherButton.textContent = timeLeft;

  const timer = setInterval(() => {
    timeLeft--;
    if (timeLeft > 0) {
      WoodGatherButton.textContent = timeLeft;
    } else {
      clearInterval(timer);
      Wood += 1;
      WoodGatherButton.textContent = 'Gather Wood';
      WoodGatherButton.disabled = false;
      WoodGathered.textContent = `Wood:${Wood}`;
    }
  }, 1000);
}
</script>
<script>
var Pelts = 0; 

function Hunt() {
let timeLeft = 5;
  const PeltButton = document.getElementById('PeltButton');
  const PeltsGathered = document.getElementById('PeltsGathered');
  PeltButton.disabled = true;
  
  timeLeft = 5; 
  PeltButton.textContent = timeLeft;

  const timer = setInterval(() => {
    timeLeft--;
    if (timeLeft > 0) {
      PeltButton.textContent = timeLeft;
    } else {
      clearInterval(timer);
      Pelts += 1;
      PeltButton.textContent = 'Hunt';
      PeltButton.disabled = false;
      PeltsGathered.textContent = `Pelts:${Pelts}`;
    }
  }, 1000);
}
</script>
<body class="mainmenu"> 

<h2 id="starttext">Laboring Lodge</h2> 

<button id="startbutton" onclick="startbutton()" class="button startbutton">Start</button> 
