<!DOCTYPE html> <html> 
<link href='https://fonts.googleapis.com/css?family=Pixelify Sans' rel='stylesheet'>
<style>  
p {
color: #FFFFFF;
font-family: 'Pixelify Sans'; 
} 

h1 {
color: #FFFFFF;
font-family: 'Pixelify Sans'; 
} 

h2 {
color: #FFFFFF;
font-family: 'Pixelify Sans'; 
} 

h3 {
color: #FFFFFF;
font-family: 'Pixelify Sans'; 
} 

body {
background-color: #000000; 
} 

.button {
background-color: #000000;
border-color: #FFFFFF;
font-family:'Pixelify Sans';
color: #FFFFFF; 
} 

.startbutton {
width: 250px;
height: 50px;
font-size: 25px;
display: flex;
align-items: center;
justify-content: center; 
} 

.mainmenu {
display: flex;
flex-direction: column;
align-items: center;
justify-content: center;
gap: 20px; 
} 

.relative1 {
position: relative;
margin: 0 auto; 
} 

.absolute1 {
position: absolute;
left: -500px;
bottom: -700px; 
}
.relative2 {
position: relative;
margin: 0 auto; 
} 

.absolute2 {
position: absolute;
left: -490px;
bottom: -600px; 
} 

.GatherButtons {
width: 150px;
height: 75px;
font-size: 25px; 
} 

.hiddenButtonReveal {
display: none; 
} 
</style> 

<script> function startbutton() {
var StartButton = document.getElementById("startbutton"); 
var StartText = document.getElementById("starttext"); 
var WoodGatherButton = document.getElementById("WoodGatherButton");
var Wood = 0;
var WoodGathered =  document.getElementById("WoodGathered");
StartButton.style.display = "none"; 
StartText.style.display= "none"; 
WoodGatherButton.classList.remove('hiddenButtonReveal');
WoodGathered.classList.remove('hiddenButtonReveal');
} 
</script> 
<script>
let Wood = 0; 
let timeLeft = 5; 

function GatherWood() {
  const WoodGatherButton = document.getElementById('WoodGatherButton');
  WoodGatherButton.disabled = true;
  
  timeLeft = 5; 
  WoodGatherButton.textContent = timeLeft;

  const timer = setInterval(() => {
    timeLeft--;
    if (timeLeft > 0) {
      WoodGatherButton.textContent = timeLeft;
    } else {
      clearInterval(timer);
      Wood += 1;
      WoodGatherButton.textContent = 'Gather Wood';
      WoodGatherButton.disabled = false;
    }
  }, 1000);
}
</script>
<body class="mainmenu"> 

<h2 id="starttext">Laboring Lodge</h2> 

<button id="startbutton" onclick="startbutton()" class="button startbutton">Start</button> 
<div class = "relative2">
<div class = "absolute2">
<h2 id="WoodGathered" class="hiddenButtonReveal">Wood:</h2>
</div>
</div>
<div class="relative1"> <div class="absolute1"> 
<button id="WoodGatherButton" onclick="GatherWood()" class="button hiddenButtonReveal GatherButtons">Gather Wood</button> 
</div> </div> </body> </html> 
